generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}

datasource db {
  provider = "postgresql"
}

enum SchoolType {
  Public
  Private
  Other
}

enum LastSchoolVerificationStatus {
  pending
  verified
  rejected
}

enum ProgramType {
  Bachelor
  SeniorHigh
  Associate
}

enum AcademicLevel {
  Grade11
  Grade12
  FirstYear
  SecondYear
  ThirdYear
  FourthYear
}

enum Semester {
  FirstSemester
  SecondSemester
}

enum Gender {
  Male
  Female
}

enum CivilStatus {
  Single
  Married
}

enum ApplicantType {
  new
  existing
}

enum ApplicationStatus {
  draft
  submitted
  reviewing
  approved
  rejected
}

enum UserRole {
  superAdmin
  admin
  registrar
  teacher
  student
}

enum VerificationTokenPurpose {
  studentUpdate
  emailVerification
  passwordReset
  teacherSetup
}

enum EmployeeStatus {
  Regular
  Probationary
  Contractual
  Resigned
}

enum EmployeeRole {
  admin
  registrar
  teacher
  nonTeaching
}

model SiteSetting {
  id                 Int      @id @default(1)
  aboutTitle         String   @map("about_title") @db.Text
  aboutIntro         String   @map("about_intro") @db.Text
  mission            String   @default("") @db.Text
  vision             String   @default("") @db.Text
  contactIntro       String   @default("") @map("contact_intro") @db.Text
  contactEmail       String   @map("contact_email") @db.VarChar(320)
  contactPhone       String   @map("contact_phone") @db.Text
  contactAddress     String   @map("contact_address") @db.Text
  officeHours        String   @default("") @map("office_hours") @db.Text
  mapUrl             String   @default("") @map("map_url") @db.Text
  facebookUrl        String   @default("") @map("facebook_url") @db.Text
  officialWebsiteUrl String   @default("") @map("official_website_url") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

model User {
  id            BigInt   @id @default(autoincrement())
  email         String   @unique @db.VarChar(320)
  passwordHash  String   @map("password_hash") @db.Text
  key           String?  @db.Text
  role          UserRole
  emailVerified Boolean  @default(false) @map("email_verified")
  sessionVersion Int     @default(0) @map("session_version")
  userImage     String?  @map("user_image") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  loginHistory LoginHistory[]
  verificationTokens VerificationToken[]
  teacher      Teacher?

  @@map("users")
}

model Employee {
  id              BigInt         @id @default(autoincrement())
  employeeId      String         @unique @map("employee_id") @db.Text
  firstName       String?        @map("first_name") @db.Text
  lastName        String?        @map("last_name") @db.Text
  middleName      String?        @map("middle_name") @db.Text
  suffix          String?        @db.Text
  birthDate       DateTime       @map("birth_date") @db.Date
  placeOfBirth    String         @map("place_of_birth") @db.Text
  gender          Gender
  civilStatus     CivilStatus    @map("civil_status")
  nationality     String         @db.Text
  address         String         @db.Text
  contactNumber   String         @map("contact_number") @db.Text
  emailAddress    String         @unique @map("email_address") @db.VarChar(320)
  userImage       String?        @map("user_image") @db.Text
  tin             String?        @db.Text
  sssNo           String?        @map("sss_no") @db.Text
  philHealthNo    String?        @map("philhealth_no") @db.Text
  pagIbigNo       String?        @map("pag_ibig_no") @db.Text
  dateStarted     DateTime       @map("date_started") @db.Date
  role            EmployeeRole
  status          EmployeeStatus
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher?
  verificationTokens VerificationToken[]

  @@index([role, status])
  @@map("employees")
}

model Teacher {
  employeeId BigInt @id @map("employee_id")
  userId     BigInt @unique @map("user_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  classes  Class[]

  @@map("teachers")
}

model Class {
  id             BigInt   @id @default(autoincrement())
  branchId       BigInt?  @map("branch_id")
  programId      BigInt?  @map("program_id")
  subjectId      BigInt?  @map("subject_id")
  schoolYear     String   @map("school_year") @db.Text
  semester       Semester?
  sectionName    String   @map("section_name") @db.Text
  yearLevel      AcademicLevel @map("year_level")
  teacherId      BigInt   @map("teacher_id")
  subjectName    String   @map("subject_name") @db.Text
  spreadsheetUrl String?  @map("spreadsheet_url") @db.Text
  prelimVisible  Boolean  @default(true) @map("prelim_visible")
  midtermVisible Boolean  @default(true) @map("midterm_visible")
  prefinalsVisible Boolean @default(true) @map("prefinals_visible")
  finalsVisible  Boolean  @default(true) @map("finals_visible")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [employeeId], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  program Program? @relation(fields: [programId], references: [id], onDelete: Restrict)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  programSubject ProgramSubject? @relation(fields: [programId, subjectId], references: [programId, subjectId], onDelete: Restrict)
  students ClassStudent[]

  @@unique([teacherId, branchId, schoolYear, semester, sectionName, yearLevel, programId, subjectId], map: "classes_assignment_key")
  @@index([teacherId, schoolYear])
  @@index([branchId, schoolYear])
  @@index([programId, subjectId])
  @@map("classes")
}

model ClassStudent {
  classId   BigInt @map("class_id")
  studentId BigInt @map("student_id")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([classId, studentId])
  @@index([studentId])
  @@map("class_students")
}

model LoginHistory {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  email     String   @db.VarChar(320)
  role      UserRole
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_history")
}

model LoginRateLimitBucket {
  id             BigInt   @id @default(autoincrement())
  scope          String   @db.Text
  identifierHash String   @map("identifier_hash") @db.Char(64)
  attempts       Int      @default(0)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, identifierHash])
  @@index([expiresAt])
  @@map("login_rate_limit_buckets")
}

model VerificationToken {
  id         BigInt    @id @default(autoincrement())
  jti        String    @unique @db.Uuid
  purpose    VerificationTokenPurpose @default(studentUpdate)
  userId     BigInt?   @map("user_id")
  employeeId BigInt?   @map("employee_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, purpose, createdAt])
  @@index([employeeId, purpose, createdAt])
  @@map("verification_tokens")
}

model Address {
  id          BigInt  @id @default(autoincrement())
  houseNumber String? @map("house_number") @db.Text
  subdivision String? @db.Text
  street      String? @db.Text

  barangay   String  @db.Text
  city       String  @db.Text
  province   String  @db.Text
  postalCode String? @map("postal_code") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lastSchools LastSchool[]
  students    Student[]
  guardians   Guardian[]
  branches    Branch[]

  @@map("addresses")
}

model LastSchool {
  id         BigInt     @id @default(autoincrement())
  schoolName String     @map("school_name") @db.Text
  schoolId   String?    @map("school_id") @db.Text
  shortName  String?    @map("short_name") @db.Text
  addressId  BigInt?    @map("address_id")
  schoolType SchoolType @map("school_type")
  verificationStatus LastSchoolVerificationStatus @default(pending) @map("verification_status")
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  address      Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  applications AdmissionApplication[]

  @@index([verificationStatus])
  @@map("last_schools")
}

model Branch {
  id           BigInt   @id @default(autoincrement())
  slug         String   @unique @db.Text
  title        String   @db.Text
  addressId    BigInt?  @map("address_id")
  phone        String?  @db.Text
  facebookText String?  @map("facebook_text") @db.Text
  mapLink      String?  @map("map_link") @db.Text
  image        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  address      Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  branchPrograms BranchProgram[]
  applications AdmissionApplication[]
  classes      Class[]

  @@map("branches")
}

model Program {
  id            BigInt      @id @default(autoincrement())
  programTypeId BigInt      @map("program_type_id")
  code          String      @unique @db.Text
  label         String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  programType   ProgramType

  slug        String?  @unique @db.Text
  publicTitle String?  @map("public_title") @db.Text
  publicCode  String?  @map("public_code") @db.Text
  note        String?  @db.Text
  overview    String?  @db.Text
  focusAreas  String[] @default([]) @map("focus_areas") @db.Text
  pathways    String[] @default([]) @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  groupId     String?  @map("group_id") @db.Text

  branchPrograms BranchProgram[]
  programSubjects ProgramSubject[]
  classes Class[]
  applications AdmissionApplication[]
  group        ProgramGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId, sortOrder])
  @@map("programs")
}

model ProgramGroup {
  id             String    @id @db.Text
  title          String    @db.Text
  description    String    @db.Text
  pathwayLabel   String    @map("pathway_label") @db.Text
  educationLevel String    @map("education_level") @db.Text
  sortOrder      Int       @default(0) @map("sort_order")
  programs       Program[]

  @@map("program_groups")
}

model Student {
  id              BigInt       @id @default(autoincrement())
  studentNumber   String?      @unique @map("student_number") @db.Text
  firstName       String       @map("first_name") @db.Text
  lastName        String       @map("last_name") @db.Text
  middleName      String?      @map("middle_name") @db.Text
  suffix          String?      @db.Text
  birthDate       DateTime     @map("birth_date") @db.Date
  gender          Gender?
  civilStatus     CivilStatus? @map("civil_status")
  citizenship     String?      @db.Text
  birthplace      String?      @db.Text
  religion        String?      @db.Text
  email           String       @unique @db.Text
  userImage       String?      @map("user_image") @db.Text
  phone           String?      @db.Text
  facebookAccount String?      @map("facebook_account") @db.Text
  addressId       BigInt?      @map("address_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  address      Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  guardians    StudentGuardian[]
  applications AdmissionApplication[]
  classes      ClassStudent[]

  @@map("students")
}

model Guardian {
  id              BigInt   @id @default(autoincrement())
  firstName       String   @map("first_name") @db.Text
  lastName        String   @map("last_name") @db.Text
  middleName      String?  @map("middle_name") @db.Text
  suffix          String?  @db.Text
  contactNumber   String   @map("contact_number") @db.Text
  occupation      String?  @db.Text
  email           String?  @db.Text
  addressId       BigInt?  @map("address_id")
  facebookAccount String?  @map("facebook_account") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  address  Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  id           BigInt   @id @default(autoincrement())
  studentId    BigInt   @map("student_id")
  guardianId   BigInt   @map("guardian_id")
  relationship String   @db.Text
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId, relationship])
  @@map("student_guardians")
}

model BranchProgram {
  branchId  BigInt   @map("branch_id")
  programId BigInt   @map("program_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@id([branchId, programId])
  @@index([programId])
  @@map("branch_program")
}

model Subject {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  code      String?  @unique @db.Text
  units     Decimal? @db.Decimal(4, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  programSubjects ProgramSubject[]
  classes Class[]

  @@map("subjects")
}

model ProgramSubject {
  programId BigInt   @map("program_id")
  subjectId BigInt   @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classes Class[]

  @@id([programId, subjectId])
  @@index([subjectId])
  @@map("program_subjects")
}

model AdmissionApplication {
  id                BigInt            @id @default(autoincrement())
  studentId         BigInt            @map("student_id")
  applicantType     ApplicantType     @map("applicant_type")
  applicationStatus ApplicationStatus @default(draft) @map("application_status")

  lastSchoolId        BigInt?   @map("last_school_id")
  LSSchoolYearEnd     String?   @map("ls_school_year_text") @db.Text
  LSAttainedLevelText String?   @map("ls_year_level_text") @db.Text
  LSGraduationDate    DateTime? @map("ls_graduation_date") @db.Date

  branchId         BigInt      @map("branch_id")
  programType      ProgramType
  programId        BigInt      @map("program_id")
  academicLevel    AcademicLevel @map("academic_level")

  remarks     String?   @db.Text
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lastSchool     LastSchool?    @relation(fields: [lastSchoolId], references: [id], onDelete: SetNull)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  program        Program        @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@map("admission_applications")
}
